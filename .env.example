# Copy to /opt/hubie/.env on the server and fill in. NEVER commit the real .env.
KICK_RTMP_URL=rtmps://YOUR-INGEST.global-contribute.live-video.net:443/app/
KICK_STREAM_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CHATROOM_ID=
KICK_CHANNEL=housebetshubie
ANTHROPIC_API_KEY=
# Optional
# HUBIE_MODEL=claude-haiku-5-5
# HUBIE_AUDIO_SHIFT=0
# Telegram control bot (optional)
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# Optional community controls from Telegram (/poll, /giveaway). Keep 0 during contest runs:
# a live command is a human action.
HUBIE_HUMAN_CONTROLS=0

# Hubie's voice (Piper). Speed >1 = slower; pitch <1 = deeper.
HUBIE_VOICE_SPEED=1.15
HUBIE_VOICE_PITCH=1.0
